#!/bin/sh
set -e

if [ "$#" -ne 3 ]; then
	echo "Usage: gpg-verify <public key file> <signature file> <signed file>" >&2
	exit 1
fi

# Use a throwaway keyring so only the given key is trusted
export GNUPGHOME="$(mktemp -d)"
trap 'gpgconf --kill all; rm -rf "$GNUPGHOME"' EXIT

gpg --batch --import "$1"
gpg --batch --verify "$2" "$3"
